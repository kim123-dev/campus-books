# 이 파일을 복사해 .env를 만들고 실제 값으로 바꿔 사용하세요. (.env는 커밋 금지)
# 로컬 개발용 예시입니다. 운영 값은 Railway 대시보드의 Variables에 직접 넣습니다.

# development(기본) 또는 production. production이면 API 문서(/docs)가 꺼지고,
# DATABASE_URL이 PostgreSQL인지, SECRET_KEY가 32자 이상인지 시작할 때 확인합니다.
ENVIRONMENT=development
# 운영에서는 postgresql://... 주소를 넣습니다. (postgresql+psycopg://로 자동 변환)
DATABASE_URL=sqlite:///./dev.db
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 판매글 사진 저장 폴더. 운영에서는 영구 디스크(볼륨) 경로를 넣습니다. (예: /data/uploads)
UPLOAD_DIR=./uploads
