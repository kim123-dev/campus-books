# 이 파일을 복사해 .env를 만들고 실제 값으로 바꿔 사용하세요. (.env는 커밋 금지)
# 로컬 개발용 예시입니다. 운영 값은 Railway 대시보드의 Variables에 직접 넣습니다.

# development(기본) 또는 production. production이면 API 문서(/docs)가 꺼지고,
# DATABASE_URL이 PostgreSQL인지, SECRET_KEY·EMAIL_HASH_KEY가 32자 이상인지 시작할 때 확인합니다.
ENVIRONMENT=development
# 운영에서는 postgresql://... 주소를 넣습니다. (postgresql+psycopg://로 자동 변환)
DATABASE_URL=sqlite:///./dev.db
SECRET_KEY=change-me
# 강제 탈퇴한 이메일의 재가입 차단용 HMAC 키. 운영에서는 필수(32자 이상, SECRET_KEY와 다른 값).
# 개발에서는 비워 두면 SECRET_KEY에서 만든 값을 씁니다. 한 번 정한 뒤 바꾸면 기존 차단이 맞지 않게 됩니다.
EMAIL_HASH_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 판매글 사진 저장 폴더. 운영에서는 영구 디스크(볼륨) 경로를 넣습니다. (예: /data/uploads)
UPLOAD_DIR=./uploads
